# Copy to .env.local and fill in. Never commit real values (NFR-002).
# .env.local is gitignored.

# Postgres connection string (Railway managed in production)
DATABASE_URL=

# Auth.js. Generate a secret with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET=
AUTH_URL=

# Metorik API (phase 2 only, leave blank for now)
METORIK_API_KEY=
METORIK_STORE_ID=

# development | production
NODE_ENV=
